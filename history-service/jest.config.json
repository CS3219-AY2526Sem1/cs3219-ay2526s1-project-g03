{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/?(*.)+(test).[tj]s"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.(ts)$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "globalSetup": "<rootDir>/src/test/globalSetup.ts",
  "setupFilesAfterEnv": ["<rootDir>/src/test/setup.ts"],
  "testTimeout": 15000,
  "maxWorkers": 3
}

